extends includes/document/layout.pug

block page-context
  -
    const pageType = ['tags', 'categories'].includes(page.type) ? page.type : 'page'
    const topImageEnabled = page.type !== '404' && !theme.disable_top_img && page.top_img !== false
    const topImage = topImageEnabled ? page.top_img || theme.default_top_img : false
    const tocEnable = theme.aside.enable && page.aside !== false && pageType === 'page' && theme.toc.page
    const pageToc = typeof page.toc === 'boolean' ? page.toc : tocEnable
    const showToc = pageToc && (toc(page.content) !== '' || page.encrypt === true)
    let resolvedTitle = page.title || config.title || ''
    if (page.type === 'tags') resolvedTitle = page.title || _p('page.tags')
    if (page.type === 'categories') resolvedTitle = page.title || _p('page.categories')
    if (page.type === '404') resolvedTitle = _p('error404')
    pageContext = {
      meta: {
        title: resolvedTitle,
        pageType,
        isHome: false,
        isPost: false,
        ogType: 'website',
        contentPage: pageType === 'page',
        bodyClass: page.type ? 'page type-' + page.type : 'page'
      },
      header: {
        variant: 'page',
        topImage,
        className: topImage !== false ? 'not-home-page' : 'not-top-img',
        hasImage: topImage !== false,
        background: topImage !== false ? getBgPath(topImage) : ''
      },
      runtime: {
        showToc,
        commentsJsLoad: false,
        needLoadCountJs: false
      },
      rightside: {
        readmode: false
      },
      sidebar: {
        variant: 'page'
      }
    }

block page-header
  include ./includes/pages/page/header.pug

block page-content
  include ./includes/pages/page/content.pug

block page-sidebar
  include ./includes/components/widgets/sidebar-page.pug
