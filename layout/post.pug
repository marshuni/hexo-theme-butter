extends includes/document/layout.pug

block page-context
  -
    const topImageEnabled = !theme.disable_top_img && page.top_img !== false
    const topImage = topImageEnabled ? page.top_img || page.cover || theme.default_top_img : false
    const tocEnable = theme.aside.enable && page.aside !== false && theme.toc.post
    const pageToc = typeof page.toc === 'boolean' ? page.toc : tocEnable
    const showToc = pageToc && (toc(page.content) !== '' || page.encrypt === true)
    pageContext = {
      meta: {
        title: page.title || config.title || '',
        pageType: 'post',
        isHome: false,
        isPost: true,
        ogType: 'article',
        contentPage: true,
        bodyClass: 'post'
      },
      header: {
        variant: 'post',
        topImage,
        className: topImage !== false ? 'post-bg' : 'not-top-img',
        hasImage: topImage !== false,
        background: topImage !== false ? getBgPath(topImage) : ''
      },
      runtime: {
        showToc,
        commentsJsLoad: false,
        needLoadCountJs: false
      },
      rightside: {
        readmode: true
      },
      sidebar: {
        variant: 'post'
      }
    }

block page-header
  include ./includes/pages/post/header.pug

block page-content
  include ./includes/pages/post/content.pug

block page-sidebar
  include ./includes/components/widgets/sidebar-post.pug
