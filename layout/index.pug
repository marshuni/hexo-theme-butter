extends includes/document/layout.pug

block page-context
  -
    const returnTopImg = img => img !== false ? img || theme.default_top_img : false
    const topImageEnabled = !theme.disable_top_img && page.top_img !== false
    const topImage = topImageEnabled ? returnTopImg(theme.index_img) : false
    pageContext = {
      meta: {
        title: page.title || config.title || '',
        pageType: 'home',
        isHome: true,
        isPost: false,
        ogType: 'website',
        contentPage: false,
        bodyClass: 'page'
      },
      header: {
        variant: 'home',
        topImage,
        className: topImage !== false ? 'full_page' : 'not-top-img',
        hasImage: topImage !== false,
        background: topImage !== false ? getBgPath(topImage) : ''
      },
      runtime: {
        showToc: false,
        commentsJsLoad: false,
        needLoadCountJs: false
      },
      rightside: {
        readmode: false
      },
      sidebar: {
        variant: 'page'
      }
    }

block page-header
  include ./includes/pages/home/header.pug

block page-content
  include ./includes/sections/listing/recent-posts.pug
  +recentPosts({ showSticky: true, pagination: 'list' })

block page-sidebar
  include ./includes/components/widgets/sidebar-page.pug
