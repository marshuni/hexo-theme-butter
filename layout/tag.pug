extends includes/document/layout.pug

block page-context
  -
    const returnTopImg = img => img !== false ? img || theme.default_top_img : false
    const topImageEnabled = !theme.disable_top_img && page.top_img !== false
    const topImage = topImageEnabled
      ? theme.tag_per_img && theme.tag_per_img[page.tag] || returnTopImg(theme.tag_img)
      : false
    page.aside = theme.aside.display.tag
    pageContext = {
      meta: {
        title: _p('page.tag') + ': ' + page.tag,
        pageType: 'tag',
        isHome: false,
        isPost: false,
        ogType: 'website',
        contentPage: false,
        bodyClass: page.type ? 'page type-' + page.type : 'page'
      },
      header: {
        variant: 'listing',
        topImage,
        className: topImage !== false ? 'not-home-page' : 'not-top-img',
        hasImage: topImage !== false,
        background: topImage !== false ? getBgPath(topImage) : ''
      },
      runtime: {
        showToc: false,
        commentsJsLoad: false,
        needLoadCountJs: false
      },
      rightside: {
        readmode: false
      },
      sidebar: {
        variant: 'page'
      }
    }

block page-header
  include ./includes/pages/listing/header.pug

block page-content
  if theme.tag_ui == 'index'
    include ./includes/sections/listing/recent-posts.pug
    +recentPosts({ showSticky: false, pagination: 'list' })
  else
    include ./includes/pages/listing/tag.pug

block page-sidebar
  include ./includes/components/widgets/sidebar-page.pug
