extends includes/document/layout.pug

block content
  if theme.tag_ui == 'index'
    include ./includes/sections/listing/recent-posts.pug
    +indexPostUI
  else
    include ./includes/sections/listing/article-sort.pug
    #tag
      .article-sort-title= _p('page.tag') + ' - ' + page.tag
      +articleSort(page.posts)
      include includes/sections/listing/pagination.pug