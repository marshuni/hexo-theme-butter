include ../components/navigation/nav.pug

mixin pageHeader(options = {})
  - const className = options.className || 'not-top-img'
  - const background = options.background || ''
  - const displayPostTitle = options.displayPostTitle === true

  header#page-header(class=className style=background)
    +siteNavigation({ displayPostTitle })
    if block
      block
